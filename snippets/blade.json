    ]
  },
  "Blade includeFirst": {
    "prefix": "includefirst",
    "description": "@includeFirst (first view that exists)",
    "body": [
      "@includeFirst(['${1:custom.name}', '${2:partials.name}'])",
      "$0"
    ]
  },
  "Blade each": {
    "prefix": "each",
    "description": "@each (view per item, with empty fallback)",
    "body": [
      "@each('${1:partials.item}', \\$${2:items}, '${3:item}', '${4:partials.empty}')",
      "$0"
    ]
  },
  "Blade component": {
    "prefix": "component",
    "description": "@component / @endcomponent",
    "body": [
      "@component('${1:components.name}')",
      "\t$0",
      "@endcomponent"
    ]
  },
  "Blade component tag": {
    "prefix": "x",
    "description": "<x-component /> tag",
    "body": [
      "<x-${1:name} $0/>"
    ]
  },
  "Blade slot": {
    "prefix": "slot",
    "description": "<x-slot> named slot",
    "body": [
      "<x-slot:${1:name}>",
      "\t$0",
      "</x-slot>"
    ]
  },
  "Blade props": {
    "prefix": "props",
    "description": "@props (anonymous component)",
    "body": [
      "@props(['${1:name}' => ${2:null}])",
      "$0"
    ]
  },
  "Blade aware": {
    "prefix": "aware",
    "description": "@aware (inherit a parent component's prop)",
    "body": [
      "@aware(['${1:name}' => ${2:null}])",
      "$0"
    ]
  },
  "Blade push": {
    "prefix": "push",
