  "Blade json": {
    "prefix": "json",
    "description": "@json (safe PHP → JS handoff)",
    "body": [
      "@json(\\$${1:data})",
      "$0"
    ]
  },
  "Blade lang": {
    "prefix": "lang",
    "description": "Translation string",
    "body": [
      "{{ __('${1:key}') }}",
