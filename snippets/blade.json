      "$0"
    ]
  },
  "Blade dump": {
    "prefix": "dump",
    "description": "@dump",
    "body": [
      "@dump(\\$${1:variable})",
      "$0"
    ]
  },
  "Blade fragment": {
    "prefix": "fragment",
    "description": "@fragment / @endfragment (partial re-render target)",
    "body": [
      "@fragment('${1:name}')",
      "\t$0",
      "@endfragment"
    ]
  },
  "Livewire directive": {
    "prefix": "livewire",
    "description": "@livewire component render",
    "body": [
      "@livewire('${1:name}')",
      "$0"
    ]
  },
  "Livewire tag": {
    "prefix": "lw",
    "description": "<livewire:component /> tag",
    "body": [
      "<livewire:${1:name} $0/>"
    ]
  },
  "Livewire persist": {
    "prefix": "persist",
    "description": "@persist (keep element across wire:navigate)",
    "body": [
      "@persist('${1:name}')",
      "\t$0",
      "@endpersist"
    ]
  },
  "Livewire teleport": {
    "prefix": "teleport",
    "description": "@teleport (move markup elsewhere in the DOM)",
    "body": [
      "@teleport('${1:body}')",
      "\t$0",
      "@endteleport"
    ]
  },
  "Livewire script": {
    "prefix": "lwscript",
    "description": "@script / @endscript (runs once per component)",
    "body": [
      "@script",
      "<script>",
      "\t$0",
      "</script>",
      "@endscript"
    ]
  },
  "Livewire assets": {
    "prefix": "lwassets",
    "description": "@assets / @endassets (loaded once per page)",
    "body": [
      "@assets",
      "\t$0",
      "@endassets"
    ]
  },
  "Livewire entangle": {
    "prefix": "entangle",
    "description": "Alpine x-data entangled with a Livewire property",
    "body": [
      "x-data=\"{ ${1:open}: @entangle('${2:open}') }\"$0"
    ]
  }
}
