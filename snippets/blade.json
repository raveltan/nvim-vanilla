{
  "Blade if": {
    "prefix": "if",
    "description": "@if / @endif",
    "body": [
      "@if (${1:condition})",
      "\t$0",
      "@endif"
    ]
  },
  "Blade if/else": {
    "prefix": "ife",
    "description": "@if / @else / @endif",
    "body": [
      "@if (${1:condition})",
      "\t$2",
      "@else",
      "\t$0",
      "@endif"
    ]
  },
  "Blade elseif": {
    "prefix": "elseif",
    "description": "@elseif",
    "body": [
      "@elseif (${1:condition})",
      "\t$0"
    ]
  },
  "Blade unless": {
    "prefix": "unless",
    "description": "@unless / @endunless",
    "body": [
      "@unless (${1:condition})",
      "\t$0",
      "@endunless"
    ]
  },
  "Blade isset": {
    "prefix": "isset",
    "description": "@isset / @endisset",
    "body": [
      "@isset(\\$${1:variable})",
      "\t$0",
      "@endisset"
    ]
  },
  "Blade empty": {
    "prefix": "empty",
    "description": "@empty / @endempty",
    "body": [
      "@empty(\\$${1:variable})",
      "\t$0",
      "@endempty"
    ]
  },
  "Blade foreach": {
    "prefix": "foreach",
    "description": "@foreach / @endforeach",
    "body": [
      "@foreach (\\$${1:items} as \\$${2:item})",
      "\t$0",
      "@endforeach"
    ]
  },
  "Blade forelse": {
    "prefix": "forelse",
    "description": "@forelse / @empty / @endforelse",
    "body": [
      "@forelse (\\$${1:items} as \\$${2:item})",
      "\t$3",
      "@empty",
      "\t$0",
      "@endforelse"
    ]
  },
  "Blade for": {
    "prefix": "for",
    "description": "@for / @endfor",
    "body": [
      "@for (\\$i = 0; \\$i < ${1:count}; \\$i++)",
      "\t$0",
      "@endfor"
    ]
  },
  "Blade while": {
    "prefix": "while",
    "description": "@while / @endwhile",
    "body": [
      "@while (${1:condition})",
      "\t$0",
      "@endwhile"
    ]
  },
  "Blade switch": {
    "prefix": "switch",
    "description": "@switch / @case / @default / @endswitch",
    "body": [
      "@switch(\\$${1:value})",
      "\t@case(${2:first})",
      "\t\t$3",
      "\t\t@break",
      "",
      "\t@default",
      "\t\t$0",
      "@endswitch"
    ]
  },
  "Blade extends": {
    "prefix": "extends",
    "description": "@extends",
    "body": [
      "@extends('${1:layouts.app}')",
      "$0"
    ]
  },
  "Blade section": {
    "prefix": "section",
    "description": "@section / @endsection",
    "body": [
      "@section('${1:content}')",
      "\t$0",
      "@endsection"
    ]
  },
  "Blade section inline": {
    "prefix": "sectioni",
    "description": "@section with inline value",
    "body": [
      "@section('${1:title}', '${2:value}')",
      "$0"
    ]
  },
  "Blade yield": {
    "prefix": "yield",
    "description": "@yield",
    "body": [
      "@yield('${1:content}')",
      "$0"
    ]
  },
  "Blade parent": {
    "prefix": "parent",
    "description": "@parent",
    "body": [
      "@parent",
      "$0"
    ]
  },
  "Blade include": {
    "prefix": "include",
    "description": "@include",
    "body": [
      "@include('${1:partials.name}')",
      "$0"
    ]
  },
  "Blade include with data": {
    "prefix": "included",
    "description": "@include with data array",
    "body": [
      "@include('${1:partials.name}', ['${2:key}' => \\$${3:value}])",
      "$0"
    ]
  },
  "Blade includeIf": {
    "prefix": "includeif",
    "description": "@includeIf (silent when missing)",
    "body": [
      "@includeIf('${1:partials.name}')",
      "$0"
    ]
  },
  "Blade includeWhen": {
    "prefix": "includewhen",
    "description": "@includeWhen",
    "body": [
      "@includeWhen(${1:condition}, '${2:partials.name}')",
