    ]
  },
  "Blade echo": {
    "prefix": "ee",
    "description": "Escaped echo",
    "body": [
      "{{ ${1:expression} }}",
      "$0"
    ]
  },
  "Blade raw echo": {
    "prefix": "eee",
    "description": "Unescaped echo — only for markup you produced",
    "body": [
      "{!! ${1:expression} !!}",
      "$0"
    ]
  },
  "Blade comment": {
    "prefix": "cc",
    "description": "Blade comment (stripped from output)",
    "body": [
      "{{-- ${1:comment} --}}",
      "$0"
    ]
  },
  "Blade dd": {
    "prefix": "dd",
    "description": "@dd",
    "body": [
